MODEL_API_KEY=            # Meta Model API key (leave blank here; on dreamz-code it comes from ~/.config/meta/model-api.env)
META_BASE_URL=https://api.meta.ai/v1
MODEL_SPARK=muse-spark-1.3
MODEL_WONDER=muse-wonder-1.0
MODEL_SAM=sam-3.1
MODEL_ASR=muse-voice-transcribe-1.0
ASR_REALTIME_URL=wss://api.meta.ai/v1/asr/realtime
EFFORT_SPARK_LIVE=medium      # live keyframe "what am I looking at" (keyframe->labels target < 3 s)
EFFORT_SPARK_EXTRACT=high     # PDF spec tables, video events, instrument reading
EFFORT_SPARK_AGENT=high       # orchestration / explanations
EFFORT_WONDER=xhigh           # report review (one call per report)
BUDGET_USD_HARD_STOP=120   # backend refuses new paid calls past this (spend alerts do not stop billing)
REPLAY_USE_CACHED_LLM=true
DATA_DIR=./data
ALLOW_MODE22=false
MMC_VIN_KEY=              # 64 hex chars (32 bytes); when blank the backend generates a dev key into DATA_DIR/vin.key
