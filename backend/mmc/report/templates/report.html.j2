<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Diagnostic report {{ report.report_id }}</title>
<style>
:root {
  --bg: #f4f2ec; --surface: #eceae2; --card: #ffffff; --ink: #201a15;
  --muted: #6b6259; --line: #ddd5c7; --accent: #b3400a;
  --ok: #1e7b34; --warn: #8a5100; --bad: #b00020;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #16130f; --surface: #221d17; --card: #241f18; --ink: #f2ebe0;
    --muted: #b8ab99; --line: #453b2f; --accent: #ff8c42;
    --ok: #7bd88f; --warn: #e8b34b; --bad: #ff8a9d;
  }
}
body { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; max-width: 60rem; margin: 0 auto; padding: 1.5rem 1rem 3rem; color: var(--ink); background: var(--bg); line-height: 1.5; }
.topbar { display: flex; align-items: center; gap: 0.75rem; background: var(--card); border: 1px solid var(--line); border-bottom: 3px solid var(--accent); border-radius: 10px; padding: 0.75rem 1rem; margin-bottom: 1.25rem; }
.mark { background: var(--accent); color: #fff; font-weight: 800; padding: 4px 10px; border-radius: 8px; }
h1 { font-size: 1.3rem; margin: 0; }
h2 { font-size: 1.1rem; margin: 1.75rem 0 0.5rem; }
h3 { font-size: 1rem; margin: 1.25rem 0 0.5rem; }
.conclusion { border: 2px solid var(--ok); border-radius: 10px; padding: 1rem 1.25rem; background: var(--card); font-size: 1.1rem; }
table { border-collapse: collapse; width: 100%; max-width: 100%; margin: 1rem 0; font-size: 0.92em; table-layout: fixed; }
th, td { border: 1px solid var(--line); padding: 0.45rem 0.6rem; text-align: left; vertical-align: top; overflow-wrap: anywhere; word-break: break-word; }
th { background: var(--surface); }
details.raw { margin-top: 0.3rem; font-size: 0.85em; }
details.raw summary { cursor: pointer; color: var(--muted); }
details.raw code { display: block; white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-all; max-width: 100%; }
.badge { display: inline-block; border: 1px solid var(--muted); border-radius: 999px; padding: 0 0.5rem; font-size: 0.85em; white-space: nowrap; }
.ai { border-color: var(--accent); color: var(--accent); }
.dsp { border-color: var(--ok); color: var(--ok); }
.manual { border-color: var(--warn); color: var(--warn); }
.phys { border-color: var(--ok); color: var(--ok); }
.kp { border-color: var(--accent); color: var(--accent); }
pre, code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.88em; }
pre { white-space: pre-wrap; word-break: break-word; background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 0.75rem 1rem; }
.muted { color: var(--muted); }
@media print {
  :root { --bg: #ffffff; --surface: #ffffff; --card: #ffffff; --ink: #000000; --muted: #333333; --line: #666666; --accent: #000000; --ok: #000000; --warn: #000000; --bad: #000000; }
  body { margin: 0; max-width: none; }
  table { table-layout: fixed; width: 100%; }
  tr, .conclusion { break-inside: avoid; }
  .badge { border: 1px solid #000; color: #000; background: none; }
  details.raw summary { color: #000; }
}
@media (max-width: 640px) { body { padding: 1rem 0.75rem 2rem; } table { font-size: 0.85em; } }
</style>
</head>
<body>
<header class="topbar"><span class="mark">MMC</span><h1>Diagnostic report</h1></header>
<div class="conclusion"><strong>{{ report.hypotheses_final[0].label.L1 }}</strong> — {{ report.conclusion }}</div>

<h2>Summary</h2>
<h3>Driver</h3>
<p>{{ report.summary_by_level.L1 }}</p>
<h3>DIY</h3>
<p>{{ report.summary_by_level.L2 }}</p>
<h3>Technician</h3>
<p>{{ report.summary_by_level.L3 }}</p>

<h2>Suspects</h2>
<table>
<tr><th>Suspect</th><th>Posterior</th></tr>
{% for h in report.hypotheses_final %}
<tr><td><strong>{{ h.label.L1 }}</strong> <span class="muted">({{ h.hypothesis_id }})</span></td><td>{{ "%.1f"|format(h.current * 100) }}%</td></tr>
{% endfor %}
</table>

<h2>Explanation trace</h2>
{% for h in report.hypotheses_final %}
<h3>{{ h.label.L1 }} ({{ h.hypothesis_id }}) — {{ h.trace|length }} updates</h3>
{% if h.trace %}
<table>
<colgroup><col style="width:4%"><col style="width:16%"><col style="width:14%"><col style="width:16%"><col style="width:6%"><col style="width:10%"><col style="width:34%"></colgroup>
<tr><th>#</th><th>Test</th><th>Expected</th><th>Measured</th><th>LR</th><th>Source</th><th>What it means</th></tr>
{% for t in h.trace %}
<tr><td>{{ t.seq }}</td><td>{{ t.test_id }}</td><td>{{ human_expected(t.expected) }}</td><td>{{ human_measured(t.test_id, t.measured) }}<details class="raw"><summary>raw</summary><code>{{ t.measured }}</code></details></td><td>×{{ t.likelihood_ratio }}</td><td><span class="badge">{{ t.lr_source }}</span></td><td>{{ t.text_L1 }}</td></tr>
{% endfor %}
</table>
{% else %}
<p>No updates yet.</p>
{% endif %}
{% endfor %}

<h2>Expected vs measured</h2>
<table>
<colgroup><col style="width:15%"><col style="width:23%"><col style="width:23%"><col style="width:11%"><col style="width:12%"><col style="width:16%"></colgroup>
<tr><th>Test</th><th>Expected</th><th>Measured</th><th>Outcome</th><th>Evaluator</th><th>How judged</th></tr>
{% for row in report.expected_vs_measured %}
<tr>
<td>{{ row.test_ref }}</td>
<td>{{ human_expected(row.expected) }}<details class="raw"><summary>raw</summary><code>{{ row.expected | tojson }}</code></details></td>
<td>{{ human_measured(row.test_ref, row.measured) }}<details class="raw"><summary>raw</summary><code>{{ row.measured | tojson }}</code></details></td>
<td>{{ row.outcome }}</td>
<td>{{ row.evaluator }}</td>
<td>{% if row.origin == "signal_processing" %}<span class="badge dsp">DSP · signal, not AI</span>{% elif row.expected and row.expected.source and row.expected.source.kind == "manual_page" %}<span class="badge manual">manual</span>{% elif row.expected and row.expected.source and row.expected.source.kind == "kp" %}<span class="badge kp">knowledge pack</span>{% elif row.expected and row.expected.source and row.expected.source.kind == "physics" %}<span class="badge phys">physics</span>{% elif row.expected and row.expected.source and row.expected.source.kind == "mode06_limit" %}<span class="badge">on-board limits</span>{% elif row.origin == "direct_observation" %}Direct observation{% else %}Deterministic ({{ row.evaluator }}){% endif %}</td>
</tr>
{% endfor %}
</table>

<h2>Evidence</h2>
<table>
<tr><th>ID</th><th>Type</th><th>Source</th></tr>
{% for ev in report.evidence %}
<tr><td class="muted">{{ ev.evidence_id[:8] }}…</td><td>{{ ev.type }}</td><td>{% if ev.ai_extracted %}<span class="badge ai">AI ({{ ev.extractor }})</span>{% else %}{{ ev.extractor }}{% endif %}{% if ev.agreement %} · {{ ev.agreement }}{% endif %}</td></tr>
{% endfor %}
</table>
{% if report.sam_overlays %}
<h2>Vision overlays</h2>
{% for ov in report.sam_overlays %}
<h3>Keyframe <span class="muted">{{ ov.evidence_id[:8] }}…</span> ({{ ov.overlays|length }} concept{{ "s" if ov.overlays|length != 1 else "" }})</h3>
{% for concept in ov.overlays %}
<p><strong>{{ concept.used_concept or concept.concept }}</strong>{% if concept.found %} <span class="badge ai">found</span>{% else %} <span class="muted">not found</span>{% endif %}</p>
{% if concept.masks %}
<table>
<tr><th>Candidate</th><th>Confidence</th><th>Role</th></tr>
{% for m in concept.masks %}
<tr><td class="muted">{{ m.object_id }}</td><td>{{ "%.2f"|format(m.score) if m.score is not none else "—" }}</td><td>{% if m.rank_label == "match" %}<span class="badge ai">match</span>{% else %}<span class="badge">other candidate</span>{% endif %}</td></tr>
{% endfor %}
</table>
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
{% if report.fallback_used %}
<p><span class="badge ai">Second opinion / fallback used (Spark Open)</span></p>
{% endif %}

<h2>Safety notes</h2>
<ul>
{% for note in report.safety_notes %}
<li>{{ note }}</li>
{% endfor %}
</ul>

<h2>AI review — Muse Wonder (does not change the diagnosis)</h2>
{% if report.wonder_review %}
<p>{{ report.wonder_review.narrative }}</p>
{% if report.wonder_review.gaps %}
<ul>
{% for gap in report.wonder_review.gaps %}
<li>{{ gap.issue }}{% if gap.test_ref %} — suggested test: {{ gap.test_ref }}{% endif %}{% if gap.evidence_id %} — evidence: {{ gap.evidence_id[:8] }}…{% endif %}{% if gap.rationale %} ({{ gap.rationale }}){% endif %}</li>
{% endfor %}
</ul>
{% endif %}
<p>Agrees with leading suspect: {{ report.wonder_review.agrees_with_top }}</p>
{% else %}
<p>AI review unavailable{% if report.wonder_unavailable %}: {{ report.wonder_unavailable }}{% endif %}.</p>
{% endif %}

<h2>Reproducibility</h2>
<pre>engine {{ report.reproducibility.engine_version }} · KP {{ report.reproducibility.kp_version }} · prompts {{ report.reproducibility.prompts_sha256 }} · log {{ report.reproducibility.log_head_hash }} · models {{ report.reproducibility.model_pins }}</pre>
<p class="muted">report {{ report.report_id }}{% if report.vin_last6 %} · vehicle ····{{ report.vin_last6 }}{% endif %}</p>
</body>
</html>
