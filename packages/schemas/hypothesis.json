{"$id":"hypothesis","$schema":"https://json-schema.org/draft/2020-12/schema","description":"A diagnostic hypothesis. Only backend/mmc/engine code may change current; the LLM never sets probabilities.","properties":{"current":{"description":"Current posterior probability.","maximum":1,"minimum":0,"type":"number"},"history":{"description":"Posterior after each update.","items":{"properties":{"cause_event":{"description":"Event seq that caused the update.","type":"string"},"p":{"type":"number"},"seq":{"type":"integer"}},"required":["cause_event","p","seq"],"type":"object"},"type":"array"},"hypothesis_id":{"description":"Snake-case id matching the KP pack key.","pattern":"^[a-z0-9_]+$","type":"string"},"label":{"description":"Human-readable labels per UX level.","properties":{"L1":{"type":"string"},"L2":{"type":"string"},"L3":{"type":"string"}},"type":"object"},"origin":{"description":"kp = from knowledge pack; ai_proposed = suggested by Spark, pending KP grounding.","enum":["ai_proposed","kp"]},"prior":{"description":"Prior probability from the KP pack.","maximum":1,"minimum":0,"type":"number"},"trace":{"description":"Per-evidence explanation trace.","items":{"properties":{"evidence_id":{"type":"string"},"expected":{"type":"string"},"likelihood_ratio":{"description":"P(evidence | this hypothesis) / P(evidence | others).","exclusiveMinimum":0,"type":"number"},"lr_source":{"description":"Where the likelihood came from (KP test id, physics fn).","type":"string"},"measured":{"type":"string"},"posterior":{"type":"number"},"prior":{"type":"number"},"seq":{"type":"integer"},"test_id":{"type":["null","string"]},"text_L1":{"type":"string"},"text_L2":{"type":"string"},"text_L3":{"type":"string"}},"required":["evidence_id","likelihood_ratio","lr_source","posterior","prior","seq"],"type":"object"},"type":"array"}},"required":["current","history","hypothesis_id","label","origin","prior","trace"],"type":"object"}
